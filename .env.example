# =============================================================================
# Job Ops - Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

MODEL=google/gemini-3-flash-preview

# Optional LLM provider override. Supported values include:
# openrouter, openai, gemini, deepseek, qwen, lmstudio, ollama, openai-compatible
# DeepSeek default base URL: https://api.deepseek.com
# Qwen default base URL: https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_PROVIDER=openrouter
# LLM_API_KEY=
# LLM_BASE_URL=

# Optional embedding settings for low-cost semantic job matching. Embeddings
# are disabled by default and require their own provider, key, and base URL;
# chat-model credentials are never inherited. Without them, scoring remains
# free and keyword-only. Limits apply only to uncached API requests.
# EMBEDDING_PROVIDER=
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_ENABLED=0
# EMBEDDING_MAX_JOBS_PER_RUN=20
# EMBEDDING_MAX_INPUT_CHARS=6000

# DEPRECATED (auto-copied to LLM_API_KEY for compatibility)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local PDF resume used for applications. Defaults to ./data/resume.pdf.
# Upload it from Settings, or set an absolute/custom path here.
# RESUME_PDF_PATH=

# Optional: Basic Auth for write access
# the app is fully unauthenticated if this isn't set, which is the default
# When set, all write actions (POST/PATCH/DELETE) require Basic Auth.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Public base URL used when background jobs need to generate absolute links
# and the request host cannot be inferred.
# Example: JOBOPS_PUBLIC_BASE_URL=https://jobops.example.com
JOBOPS_PUBLIC_BASE_URL=

# =============================================================================
# Gmail OAuth (Tracking Inbox) - optional
# =============================================================================
# Required to connect Gmail from the UI.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# Optional override for OAuth callback URL.
# If unset, defaults to <request-origin>/oauth/gmail/callback
# GMAIL_OAUTH_REDIRECT_URI=http://localhost:3005/oauth/gmail/callback

# =============================================================================
# WhatsApp notifications (optional)
# =============================================================================
# Recommended: configure and test these fields in Settings → Notifications &
# Webhooks. Environment variables are useful for unattended deployments.
# WHATSAPP_ENABLED=1
# CALLMEBOT_PHONE=15551234567
# CALLMEBOT_API_KEY=
#
# Legacy webhook relay only: start `docker compose --profile notifications up -d`,
# point a webhook URL at http://whatsapp-relay:8787, and use the same secret.
# WHATSAPP_RELAY_SECRET=

# =============================================================================
# Adzuna (multi-country API source) - optional
# =============================================================================
# App credentials from Adzuna developer account.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional default per-term cap (can be overridden by UI run budget logic).
# ADZUNA_MAX_JOBS_PER_TERM=50

# =============================================================================
# JobSpy - Job search configuration
# =============================================================================
# Filter for remote-only jobs (default: 0 = disabled)
# JOBSPY_IS_REMOTE=0
# Only return roles posted within this many hours. A 24-hour default keeps
# recurring searches focused on fresh jobs.
# JOBSPY_HOURS_OLD=24

# =============================================================================
# Optional recurring discovery via Docker Compose
# =============================================================================
# Start it with: docker compose --profile scheduler up -d
# Indeed runs on the core cadence; LinkedIn is added less often to reduce
# account-risk exposure. Values are whole minutes.
# PIPELINE_SCHEDULE_CORE_MINUTES=60
# PIPELINE_SCHEDULE_LINKEDIN_MINUTES=180
# Running pipeline records older than this are marked failed on server startup.
# PIPELINE_STALE_AFTER_MINUTES=30
